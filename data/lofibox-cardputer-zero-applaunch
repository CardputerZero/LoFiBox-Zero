#!/bin/sh
# SPDX-License-Identifier: CC0-1.0

set -eu

find_st7789v_fbdev()
{
    [ -r /proc/fb ] || return 1

    while IFS= read -r line; do
        case "$line" in
            *fb_st7789v*)
                set -- $line
                case "${1:-}" in
                    ''|*[!0-9]*) return 1 ;;
                    *) printf '/dev/fb%s\n' "$1"; return 0 ;;
                esac
                ;;
        esac
    done < /proc/fb

    return 1
}

case "$0" in
    */*) script_dir=${0%/*} ;;
    *) script_dir=/usr/lib/lofibox ;;
esac

: "${LOFIBOX_WEBUI:=1}"
: "${LOFIBOX_WEBUI_BIND:=0.0.0.0}"
: "${LOFIBOX_WEBUI_PORT:=8765}"
export LOFIBOX_WEBUI LOFIBOX_WEBUI_BIND LOFIBOX_WEBUI_PORT

backend=${LOFIBOX_DISPLAY_BACKEND:-auto}

case "$backend" in
    wayland|labwc)
        if command -v lofibox-wayland >/dev/null 2>&1; then
            exec lofibox-wayland "$@"
        fi
        if command -v lofibox >/dev/null 2>&1; then
            exec lofibox "$@"
        fi
        echo "lofibox-applaunch: native Wayland runtime is not installed" >&2
        exit 127
        ;;
    x11|xwayland)
        if command -v lofibox-x11 >/dev/null 2>&1; then
            exec lofibox-x11 "$@"
        fi
        if command -v lofibox >/dev/null 2>&1; then
            exec lofibox "$@"
        fi
        echo "lofibox-applaunch: X11 runtime is not installed" >&2
        exit 127
        ;;
    fb|fbdev|framebuffer|device)
        ;;
    auto|"")
        if [ -n "${WAYLAND_DISPLAY:-}" ]; then
            if command -v lofibox-wayland >/dev/null 2>&1; then
                exec lofibox-wayland "$@"
            fi
        fi
        if [ -n "${DISPLAY:-}" ]; then
            if command -v lofibox-x11 >/dev/null 2>&1; then
                exec lofibox-x11 "$@"
            fi
        fi
        ;;
    *)
        echo "lofibox-applaunch: unsupported LOFIBOX_DISPLAY_BACKEND=$backend" >&2
        exit 2
        ;;
esac

if [ "$backend" = "auto" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    echo "lofibox-applaunch: Wayland session is active but native runtime is not installed; falling back to framebuffer" >&2
fi

if [ "$backend" = "auto" ] && [ -n "${DISPLAY:-}" ]; then
    echo "lofibox-applaunch: X11 session is active but desktop runtime is not installed; falling back to framebuffer" >&2
fi

if [ -z "${LOFIBOX_FBDEV:-}" ]; then
    if [ -n "${APPLAUNCH_LINUX_FBDEV_DEVICE:-}" ]; then
        LOFIBOX_FBDEV=$APPLAUNCH_LINUX_FBDEV_DEVICE
    elif detected_fbdev=$(find_st7789v_fbdev); then
        LOFIBOX_FBDEV=$detected_fbdev
    else
        LOFIBOX_FBDEV=/dev/fb1
    fi
fi

if [ -z "${LOFIBOX_INPUT_DEV:-}" ]; then
    LOFIBOX_INPUT_DEV="${APPLAUNCH_LINUX_KEYBOARD_DEVICE:-/dev/input/by-path/platform-3f804000.i2c-event}"
fi

export LOFIBOX_FBDEV LOFIBOX_INPUT_DEV

exec "$script_dir/lofibox_zero_device" "$@"
